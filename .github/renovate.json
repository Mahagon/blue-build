{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "abandonments:recommended",
    "group:recommended",
    ":configMigration",
    ":pinDevDependencies",
    ":gitSignOff"
  ],
  "prCreation": "immediate",
  "automerge": true,
  "automergeType": "pr",
  "customDatasources": {
    "pytorch-rocm": {
      "defaultRegistryUrlTemplate": "https://download.pytorch.org/whl/",
      "format": "html"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update version variables in install scripts",
      "managerFilePatterns": [
        "/scripts/.+\\.sh$/",
        "/files/gaming/usr/bin/comfyui$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\n\\w+=\\\"(?<currentValue>.+?)\\\""
      ]
    }
  ]
}
